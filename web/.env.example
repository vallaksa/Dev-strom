# Copy to .env.local for local overrides (gitignored by Vite's default .gitignore).

# When "true", forces demo mode ON for every visitor at build time — every
# page renders from local fixtures instead of calling the live API. Useful
# for a backend-less preview/review deployment. Leave unset for normal dev
# against a real backend; demo mode can still be toggled per-browser at
# runtime from the "Demo Mode" switch in the top nav (persisted to
# localStorage) unless this is set.
VITE_DEMO_MODE=false
