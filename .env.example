OPENAI_API_KEY=
TAVILY_API_KEY=

# URL of the running FastAPI server (used by Streamlit to make HTTP calls)
API_BASE_URL=http://localhost:8000

# PostgreSQL connection string (V3-2)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Neo4j (F1-4, optional — only needed when CARTOGRAPH_STORE_BACKEND=neo4j)
# Same hosting model as Postgres on this server: a standalone Docker daemon on
# global-network (see README "Project Cartographer / Neo4j").
# From the host: neo4j://localhost:7687
# From another container on global-network: neo4j://neo4j:7687
# Aura: neo4j+s://xxxx.databases.neo4j.io ; NEO4J_USERNAME is accepted as an alias of NEO4J_USER.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devstrom

# Which CartographStore backend to use for Project Cartographer runs.
# One of: postgres (default), neo4j
CARTOGRAPH_STORE_BACKEND=postgres

# LLM model + fallback chain used by the idea-generation and expand agents.
# DEVSTROM_MODEL_FALLBACKS is a JSON array, tried in order if the primary fails.
# DEVSTROM_MODEL=gpt-5-mini
# DEVSTROM_MODEL_FALLBACKS=["gpt-4.1-mini", "gpt-4o-mini"]

# Logging level for the API and graph (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL MCP server (V3-6) — Docker / Streamable HTTP
MCP_HTTP_URL=http://127.0.0.1:3000/mcp
MCP_API_KEY=

# Optional: stdio MCP via local postgresql-mcp repo (scripts/start_mcp.sh)
MCP_POSTGRES_URL=

# Enable MCP tool integration in the idea agent (V3-7)
ENABLE_MCP=false

# LangSmith tracing (LANGSMITH_* preferred; LANGCHAIN_* aliases also work)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DevStrom
