API_KEY=
TAVILY_API_KEY=

# PostgreSQL connection string (V3-2)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# LLM: switch models in config/llm.json (`active`) or override:
# DEVSTROM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# DEVSTROM_MODEL_FALLBACKS=["z-ai/glm-5.3-flash"]

# Logging level for the API and graph (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Auth (Google + GitHub OAuth) ─────────────────────────────────────────────
# Leave AUTH_ENABLED=false for local dev — every request runs as the seeded
# anonymous user and there's no login gate. Set true in any deployment that
# should require sign-in, and fill in SESSION_SECRET + at least one provider.
AUTH_ENABLED=false
SESSION_SECRET=                       # `python -c "import secrets;print(secrets.token_hex(32))"`
WEB_BASE_URL=http://localhost:5173    # where to send the browser after login
SESSION_TTL_DAYS=7

# Google:  console.cloud.google.com → APIs & Services → Credentials → OAuth client
#          Authorized redirect URI: <API_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub:  github.com/settings/developers → New OAuth App
#          Authorization callback URL: <API_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostgreSQL MCP server (V3-6) — Docker / Streamable HTTP
MCP_HTTP_URL=http://127.0.0.1:3000/mcp
MCP_API_KEY=

# Optional: stdio MCP via local postgresql-mcp repo (scripts/start_mcp.sh)
MCP_POSTGRES_URL=

# Enable MCP tool integration in the idea agent (V3-7)
ENABLE_MCP=false

# LangSmith tracing (LANGSMITH_* preferred; LANGCHAIN_* aliases also work)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DevStrom
